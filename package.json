{
  "name": "yongui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "build-storybook": "storybook build",
    "commit": "cz",
    "dev": "vite",
    "format": "biome check .",
    "format:fix": "biome check --write .",
    "prepare": "simple-git-hooks && panda codegen",
    "preview": "vite preview",
    "sb": "storybook dev -p 6006",
    "storybook": "storybook dev -p 6006",
    "test": "vitest",
    "test:sb": "bun run sb & sleep 5 && bun run test-storybook && kill %1",
    "test-storybook": "test-storybook"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run test:sb && bunx lint-staged"
  },
  "lint-staged": {
    "*.{css,js,json,jsx,ts,tsx}": "biome check --write --unsafe --no-errors-on-unmatched --files-ignore-unknown=true",
    "package.json": "sort-package-json"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "axe-playwright": "^2.2.2",
    "chromatic": "^16.1.0",
    "lucide-react": "^1.8.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@chromatic-com/storybook": "^5.1.1",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@commitlint/cz-commitlint": "^20.5.1",
    "@commitlint/prompt": "^20.5.0",
    "@commitlint/types": "^20.5.0",
    "@faker-js/faker": "^10.4.0",
    "@pandacss/dev": "^1.9.1",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-designs": "^11.1.3",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/addon-themes": "^10.3.5",
    "@storybook/addon-vitest": "^10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@storybook/test-runner": "^0.24.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "commitizen": "^4.3.1",
    "commitlint": "^20.5.0",
    "happy-dom": "^20.8.9",
    "lint-staged": "^16.4.0",
    "simple-git-hooks": "^2.13.1",
    "sort-package-json": "^3.6.1",
    "storybook": "^10.3.5",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.4"
  }
}
