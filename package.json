{
  "name": "yongui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "build-storybook": "storybook build",
    "commit": "cz",
    "dev": "vite",
    "format": "biome check .",
    "format:fix": "biome check --write .",
    "prepare": "simple-git-hooks && panda codegen --clean",
    "preview": "vite preview",
    "sb": "storybook dev -p 6006",
    "storybook": "storybook dev -p 6006",
    "test": "vitest",
    "test:sb": "bun run sb & sleep 5 && bun run test-storybook && kill %1",
    "test-storybook": "test-storybook"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run test:sb && bunx lint-staged"
  },
  "lint-staged": {
    "*.{css,js,json,jsx,ts,tsx}": "biome check --write --unsafe --no-errors-on-unmatched --files-ignore-unknown=true",
    "package.json": "sort-package-json"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "lucide-react": "^1.78.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@chromatic-com/storybook": "^5.6.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/cz-commitlint": "^21.2.4",
    "@commitlint/prompt": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@faker-js/faker": "^10.6.0",
    "@pandacss/dev": "^2.6.0",
    "@pandacss/preset-base": "^2.6.0",
    "@pandacss/preset-panda": "^2.6.0",
    "@pandacss/types": "^2.6.0",
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/addon-designs": "^12.0.0",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/addon-themes": "^10.6.8",
    "@storybook/addon-vitest": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@storybook/test-runner": "^0.26.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-playwright": "^2.2.2",
    "chromatic": "^18.15.1",
    "commitizen": "^4.3.2",
    "commitlint": "^21.2.4",
    "happy-dom": "^21.0.4",
    "lint-staged": "^17.6.2",
    "simple-git-hooks": "^2.14.0",
    "sort-package-json": "^4.1.0",
    "storybook": "^10.6.8",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.1.1"
  },
  "packageManager": "bun@1.4.5"
}
